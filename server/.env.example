# ==============================================================================
# Pizza Co. Backend Environment Configuration Example
# Copy this file to .env and replace placeholders with your actual credentials.
# ==============================================================================

# Server Network Configuration
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB local or Atlas)
MONGODB_URI=mongodb://localhost:27017/pizza_app

# JWT Authentication Secret (Use a strong random string in production)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Nodemailer Email Service (Gmail / SMTP credentials for verification & reset links)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_16_digit_app_password

# Razorpay Test Mode Credentials (From https://dashboard.razorpay.com/#/access/api-keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Default Initial Admin Account Credentials (Used by seed script)
ADMIN_EMAIL=admin@pizzaco.com
ADMIN_PASSWORD=Admin@123456
